        </zone>
        <zone h='11019' id='37' type-v2='text' w='25365' x='12917' y='7407'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Section 1: Key Findings</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>43.14%</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>On-Time Delivery</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Less than half of eligible delivered shipments arrived on or before their expected delivery date.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='9630' id='38' type-v2='text' w='25521' x='12604' y='19074'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>20.01 days</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Average Transit Time</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Eligible delivered shipments took approximately 20 days on average.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='8704' id='39' type-v2='text' w='22656' x='12500' y='28704'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>19</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Missing Port Identifiers</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Some port references could not be matched with Port_Master.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='8148' id='40' type-v2='text' w='25365' x='41354' y='5185'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Section 2: Business Recommendations</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>-&gt;Review carrier performance and investigate reasons for delivery delays</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='5833' id='41' type-v2='text' w='25365' x='41198' y='13241'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>-&gt;Investigate routes with higher average transit times and review vessel schedules.</run>
          </formatted-text>
        </zone>
        <zone h='5926' id='42' type-v2='text' w='25365' x='41302' y='19630'>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>-&gt;Update missing port identifiers and validate port master records regularly.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </zone>
        <zone h='2778' id='43' type-v2='text' w='13906' x='12760' y='38981'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book' fontsize='12'>Section 3: Data Limitations</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='2778' id='44' type-v2='text' w='15833' x='12813' y='42407'>
