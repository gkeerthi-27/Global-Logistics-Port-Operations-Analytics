      <column caption='Mapped Origin Shipments.' datatype='integer' name='[Calculation_0125406461538304]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([Origin_Port_ID])&#13;&#10;    THEN [Shipment_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Mapped Destination Shipments' datatype='integer' name='[Calculation_0125406462029825]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF NOT ISNULL([Destination_Port_ID])&#13;&#10;    THEN [Shipment_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Countries Connected' datatype='integer' name='[Calculation_0125406462259202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Country])' />
      </column>
      <column caption='Origin Shipments' datatype='integer' name='[Calculation_0125406464274435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Shipment_ID])' />
      </column>
      <column caption='Destination Shipments:' datatype='integer' name='[Calculation_0125406464520196]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Shipment_ID])' />
      </column>
      <column caption='Total Delayed Shipments' datatype='integer' name='[Calculation_0125406466560005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Shipment_Status] = &quot;Delayed&quot;&#13;&#10;    THEN [Shipment_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Total Shipping Routes' datatype='string' name='[Calculation_0787313370030080]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Port_Name (Sheet19)] + &quot; → &quot; +[Port_Name]' />
      </column>
      <column caption='Total Delivered Shipments' datatype='integer' name='[Calculation_0787313370734593]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    THEN [Shipment_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Shipping Route' datatype='real' name='[Calculation_0787313372151810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Shipment_Date])&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    THEN DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        [Shipment_Date],&#13;&#10;        [Actual_Delivery_Date]&#13;&#10;    )&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Shipping Routes' datatype='string' name='[Calculation_0787313373704195]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Port_Name (Sheet19)] + &quot; → &quot; +&#13;&#10;[Port_Name]' />
      </column>
      <column caption='Average Transit Times' datatype='real' name='[Calculation_0787313374326788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Shipment_Date])&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    THEN DATEDIFF(&#13;&#10;        &apos;day&apos;,&#13;&#10;        [Shipment_Date],&#13;&#10;        [Actual_Delivery_Date]&#13;&#10;    )&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Late Delivered Shipments' datatype='integer' name='[Calculation_1435749552312320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    AND NOT ISNULL([Expected_Delivery_Date])&#13;&#10;    AND [Actual_Delivery_Date] &gt; [Expected_Delivery_Date]&#13;&#10;    THEN [Shipment_ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Maximum Delivery Delay' datatype='integer' name='[Calculation_1435749553065985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    AND NOT ISNULL([Expected_Delivery_Date])&#13;&#10;    AND [Actual_Delivery_Date] &gt; [Expected_Delivery_Date]&#13;&#10;    THEN&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;day&apos;,&#13;&#10;            [Expected_Delivery_Date],&#13;&#10;            [Actual_Delivery_Date]&#13;&#10;        )&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='On-Time Delivery %' datatype='real' name='[Calculation_2067693717303296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    AND NOT ISNULL([Expected_Delivery_Date])&#13;&#10;    AND [Actual_Delivery_Date] &lt;= [Expected_Delivery_Date]&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    AND NOT ISNULL([Expected_Delivery_Date])&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Shipment Delay Rate %.' datatype='real' name='[Calculation_2067693718081537]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Shipment_Status] = &quot;Delayed&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF NOT ISNULL([Shipment_Status])&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Average Transit Time' datatype='real' name='[Calculation_2067693721669636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Shipment_Date])&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    THEN&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;day&apos;,&#13;&#10;            [Shipment_Date],&#13;&#10;            [Actual_Delivery_Date]&#13;&#10;        )&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Average Delivery Delay.' datatype='real' name='[Calculation_2067693722193925]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    AND NOT ISNULL([Expected_Delivery_Date])&#13;&#10;    AND [Actual_Delivery_Date] &gt; [Expected_Delivery_Date]&#13;&#10;    THEN&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;day&apos;,&#13;&#10;            [Expected_Delivery_Date],&#13;&#10;            [Actual_Delivery_Date]&#13;&#10;        )&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Month Year' datatype='string' name='[Calculation_2067693724475398]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Shipment_Date])&#13;&#10;+ &quot; &quot; +&#13;&#10;STR(YEAR([Shipment_Date]))' />
      </column>
      <column caption='Sort Month Year' datatype='integer' name='[Calculation_2067693725110279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Shipment_Date]) * 100&#13;&#10;+ MONTH([Shipment_Date])' />
      </column>
