    <worksheet name='Shipment Delay Rate %.'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Carrier_Master)' name='federated.0nysyeb1jl3yn318a8s6t19i40tp' />
          </datasources>
          <datasource-dependencies datasource='federated.0nysyeb1jl3yn318a8s6t19i40tp'>
            <column caption='Shipment Delay Rate %.' datatype='real' name='[Calculation_2067693718081537]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Shipment_Status] = &quot;Delayed&quot;&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(&#13;&#10;    IF NOT ISNULL([Shipment_Status])&#13;&#10;    THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Shipment Status' datatype='string' name='[Shipment_Status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2067693718081537]' derivation='User' name='[usr:Calculation_2067693718081537:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
