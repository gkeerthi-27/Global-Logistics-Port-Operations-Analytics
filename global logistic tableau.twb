    <worksheet name='Total Delayed Shipments'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Carrier_Master)' name='federated.0nysyeb1jl3yn318a8s6t19i40tp' />
          </datasources>
          <datasource-dependencies datasource='federated.0nysyeb1jl3yn318a8s6t19i40tp'>
            <column caption='Total Delayed Shipments' datatype='integer' name='[Calculation_0125406466560005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Shipment_Status] = &quot;Delayed&quot;&#13;&#10;    THEN [Shipment_ID]&#13;&#10;    END&#13;&#10;)' />
