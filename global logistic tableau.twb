            <column caption='Month Year' datatype='string' name='[Calculation_2067693724475398]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Shipment_Date])&#13;&#10;+ &quot; &quot; +&#13;&#10;STR(YEAR([Shipment_Date]))' />
