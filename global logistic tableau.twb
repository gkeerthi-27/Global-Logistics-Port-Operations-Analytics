        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0nysyeb1jl3yn318a8s6t19i40tp].[usr:Calculation_2067693717303296:qk]' />
            </encodings>
            <customized-label>
