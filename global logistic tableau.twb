  <worksheets>
    <worksheet name='Average Delivery Delay'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Carrier_Master)' name='federated.0nysyeb1jl3yn318a8s6t19i40tp' />
          </datasources>
          <datasource-dependencies datasource='federated.0nysyeb1jl3yn318a8s6t19i40tp'>
            <column caption='Actual Delivery Date' datatype='datetime' name='[Actual_Delivery_Date]' role='dimension' type='ordinal' />
            <column caption='Average Delivery Delay.' datatype='real' name='[Calculation_2067693722193925]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(&#13;&#10;    IF [Shipment_Status] = &quot;Delivered&quot;&#13;&#10;    AND NOT ISNULL([Actual_Delivery_Date])&#13;&#10;    AND NOT ISNULL([Expected_Delivery_Date])&#13;&#10;    AND [Actual_Delivery_Date] &gt; [Expected_Delivery_Date]&#13;&#10;    THEN&#13;&#10;        DATEDIFF(&#13;&#10;            &apos;day&apos;,&#13;&#10;            [Expected_Delivery_Date],&#13;&#10;            [Actual_Delivery_Date]&#13;&#10;        )&#13;&#10;    END&#13;&#10;)' />
            </column>
            <column caption='Expected Delivery Date' datatype='datetime' name='[Expected_Delivery_Date]' role='dimension' type='ordinal' />
            <column caption='Shipment Status' datatype='string' name='[Shipment_Status]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2067693722193925]' derivation='User' name='[usr:Calculation_2067693722193925:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='text-format' field='[federated.0nysyeb1jl3yn318a8s6t19i40tp].[usr:Calculation_2067693722193925:qk]' value='n#,##0.00;-#,##0.00' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='2' />
            <format attr='border-color' value='#000000' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <text column='[federated.0nysyeb1jl3yn318a8s6t19i40tp].[usr:Calculation_2067693722193925:qk]' />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold='true' fontname='72 Condensed' fontsize='12'>Average Delivery Delay</run>
                <run>Æ&#10;</run>
                <run bold='true' fontname='72 Condensed' fontsize='12'><![CDATA[<[federated.0nysyeb1jl3yn318a8s6t19i40tp].[usr:Calculation_2067693722193925:qk]>.Days]]></run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element='cell'>
                <format attr='text-align' value='center' />
                <format attr='vertical-align' value='center' />
              </style-rule>
